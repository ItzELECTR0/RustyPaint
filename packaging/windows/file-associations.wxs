                <RegistryValue Root="HKLM" Key="Software\Classes\RustyPaint.bmp\shell\open\command" Value="&quot;[!Path]&quot; &quot;%1&quot;" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\Classes\.bmp\OpenWithProgids" Name="RustyPaint.bmp" Value="" Type="string"/>
