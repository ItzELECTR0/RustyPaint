<?xml version="1.0" encoding="utf-8"?>
<!--
  cargo-packager 0.11.8 renders `association.ext` in its own WiX template while a
  FileAssociation serialises `extensions`, so its built-in file associations expand
  to nothing at all. This fragment does the registration instead, and the packager
  metadata is what macOS reads.

  Every format is offered through OpenWithProgids and Default Apps rather than
  claimed outright, so installing RustyPaint never takes an extension away from
  whatever already owns it.
-->
<?if $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
<?else?>
    <?define Win64 = "no" ?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <ComponentGroup Id="FileAssociations" Directory="INSTALLDIR">
            <Component Id="FileAssociations" Guid="1F0E5A34-7C6B-4D91-9A2E-3B8C5D4F6071" Win64="$(var.Win64)">
                <RegistryValue Root="HKLM" Key="Software\RustyPaint\Capabilities" Name="ApplicationName" Value="RustyPaint" Type="string" KeyPath="yes"/>
                <RegistryValue Root="HKLM" Key="Software\RustyPaint\Capabilities" Name="ApplicationDescription" Value="Paint 3D&apos;s 2D editor, without the 3D" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="RustyPaint" Value="Software\RustyPaint\Capabilities" Type="string"/>

                <RegistryValue Root="HKLM" Key="Software\Classes\RustyPaint.png" Value="PNG image" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\Classes\RustyPaint.png\DefaultIcon" Value="&quot;[!Path]&quot;,0" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\Classes\RustyPaint.png\shell\open\command" Value="&quot;[!Path]&quot; &quot;%1&quot;" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="RustyPaint.png" Value="" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\RustyPaint\Capabilities\FileAssociations" Name=".png" Value="RustyPaint.png" Type="string"/>

                <RegistryValue Root="HKLM" Key="Software\Classes\RustyPaint.jpg" Value="JPEG image" Type="string"/>
