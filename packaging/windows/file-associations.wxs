                <RegistryValue Root="HKLM" Key="Software\Classes\RustyPaint.jpg\shell\open\command" Value="&quot;[!Path]&quot; &quot;%1&quot;" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="RustyPaint.jpg" Value="" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\RustyPaint\Capabilities\FileAssociations" Name=".jpg" Value="RustyPaint.jpg" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="RustyPaint.jpg" Value="" Type="string"/>
                <RegistryValue Root="HKLM" Key="Software\RustyPaint\Capabilities\FileAssociations" Name=".jpeg" Value="RustyPaint.jpg" Type="string"/>

